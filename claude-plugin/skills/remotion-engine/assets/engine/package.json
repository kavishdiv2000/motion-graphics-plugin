{
  "name": "motion-studio",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Deterministic motion-graphics engine, installed per workspace at .motion-graphics/.engine: DESIGN.md + session CHOREOGRAPHY.md + CONTENT.md -> spec -> Remotion render -> MP4",
  "scripts": {
    "mg": "node scripts/mg.mjs",
    "sfx": "node scripts/sfx-library.mjs",
    "metrics": "node scripts/font-metrics.mjs",
    "sfx-docs": "node scripts/sfx-docs.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "5.2.8",
    "@fontsource/jetbrains-mono": "5.2.8",
    "@fontsource/michroma": "5.2.8",
    "@remotion/bundler": "4.0.531",
    "@remotion/cli": "4.0.531",
    "@remotion/renderer": "4.0.531",
    "fontkit": "2.0.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.531",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "typescript": "5.6.3"
  },
  "engines": {
    "node": ">=18.18"
  }
}
