{
  "description": "motion-graphics: log the tokens each turn consumed into .motion-graphics/sessions/<id>/usage.json (no-op outside a motion-graphics workspace)",
  "hooks": {
    "Stop": [
      { "hooks": [ { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/skills/motion-graphics/scripts/usage-hook.mjs\" claude-code", "timeout": 30 } ] }
    ],
    "SessionEnd": [
      { "hooks": [ { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/skills/motion-graphics/scripts/usage-hook.mjs\" claude-code", "timeout": 30 } ] }
    ]
  }
}
